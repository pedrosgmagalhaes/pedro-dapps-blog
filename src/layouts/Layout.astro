---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, TAGLINE_WORDS, NEWSLETTER_API, VAPID_PUBLIC_KEY, GA_MEASUREMENT_ID } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  // Dados estruturados (JSON-LD): objeto único ou lista de objetos
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, ogImageWidth, ogImageHeight, jsonLd } = Astro.props;
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const pageTitle = title ? `${title} — Pedro dApps` : SITE_TITLE;
const pageDescription = description ?? SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogSrc = ogImage ?? '/og-thumbnail.png';
const ogImageUrl = new URL(ogSrc, Astro.site);
const ogExt = ogSrc.split('?')[0].split('.').pop()?.toLowerCase();
const ogImageType =
  ogExt === 'jpg' || ogExt === 'jpeg'
    ? 'image/jpeg'
    : ogExt === 'webp'
      ? 'image/webp'
      : 'image/png';
// Dimensões: capas dos posts são geradas em 1200x630; fallback é 1200x670
const ogWidth = ogImageWidth ?? 1200;
const ogHeight = ogImageHeight ?? (ogImage ? 630 : 670);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={AUTHOR} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Pedro dApps — Blog" href="/rss.xml" />

    <meta name="theme-color" content="#080808" />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <!-- Dados estruturados (JSON-LD) -->
    {jsonLdItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <!-- Favicons (identidade do site oficial) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon-180x180.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/images/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/images/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/images/apple-touch-icon-167x167.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Pedro dApps" />

    <!-- Preload de fontes e imagem do hero -->
    <link rel="preload" href="/posters/intro.jpg" as="image" fetchpriority="high" />
    <link rel="preload" href="/fonts/playfair-display-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Manrope-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anton-v27-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.youtube.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Pedro dApps" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={ogWidth} />
    <meta property="og:image:height" content={ogHeight} />
    <meta property="og:image:alt" content={pageTitle} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pedro_dapps" />
    <meta name="twitter:creator" content="@pedro_dapps" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- GSAP local (igual ao site oficial) -->
    <script src="/vendor/gsap.min.js" defer></script>
    <script is:inline define:vars={{ taglineWords: TAGLINE_WORDS }}>
      window.BLOG_TAGLINE_WORDS = taglineWords;
    </script>

    <!-- Google Analytics 4 · Pedro dApps (Consent Mode v2 / LGPD)
         Stream: Blog · G-SNM480VFH8 — coleta só após o aceite no banner -->
    <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      (function () {
        var granted = false;
        try { granted = localStorage.getItem('pd_consent_v1') === 'granted'; } catch (e) {}
        gtag('consent', 'default', {
          ad_storage: granted ? 'granted' : 'denied',
          ad_user_data: granted ? 'granted' : 'denied',
          ad_personalization: granted ? 'granted' : 'denied',
          analytics_storage: granted ? 'granted' : 'denied',
          personalization_storage: granted ? 'granted' : 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
      })();
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
  </head>
  <body class="is-loading">
    <Preloader />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/blog.js';</script>
    <script is:inline define:vars={{ newsletterApi: NEWSLETTER_API, vapidPublicKey: VAPID_PUBLIC_KEY }}>
      window.NEWSLETTER_API = newsletterApi;
      window.VAPID_PUBLIC_KEY = vapidPublicKey;
    </script>
    <script>import '../scripts/subscribe.js';</script>
    <noscript>
      <style>
        .preloader,
        .wipe-edge {
          display: none !important;
        }
        body.is-loading {
          overflow: auto !important;
        }
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- Banner de consentimento (LGPD) · Google Analytics -->
    <div id="pd-consent" role="dialog" aria-modal="false" aria-label="Aviso de cookies e privacidade" hidden>
      <div class="pd-consent-inner">
        <p class="pd-consent-title">Sua privacidade importa</p>
        <p class="pd-consent-text">
          Usamos o Google Analytics para entender como você usa este site e melhorar o conteúdo.
          Os dados só são coletados após o seu aceite.
          <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener">Saiba como o Google usa os dados</a>.
        </p>
        <div class="pd-consent-actions">
          <button type="button" class="pd-consent-btn pd-consent-allow" data-pd-consent="granted">Aceitar</button>
          <button type="button" class="pd-consent-btn pd-consent-deny" data-pd-consent="denied">Recusar</button>
        </div>
      </div>
    </div>
    <style>
      #pd-consent{position:fixed;left:16px;right:16px;bottom:16px;z-index:2147483000;max-width:520px;margin:0 auto;background:rgba(10,10,9,.96);border:1px solid rgba(200,155,82,.28);border-radius:14px;box-shadow:0 18px 50px rgba(0,0,0,.55);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);color:#f4f4f1;font-family:ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;line-height:1.5}
      #pd-consent[hidden]{display:none}
      .pd-consent-inner{padding:18px 20px}
      .pd-consent-title{margin:0 0 6px;font-size:15px;font-weight:700;letter-spacing:.02em}
      .pd-consent-text{margin:0 0 14px;font-size:13px;color:rgba(244,244,241,.72)}
      .pd-consent-text a{color:#d8b36e;text-decoration:underline}
      .pd-consent-actions{display:flex;gap:8px;flex-wrap:wrap}
      .pd-consent-btn{flex:1 1 auto;min-width:120px;padding:10px 14px;border-radius:10px;border:1px solid transparent;font-size:13.5px;font-weight:600;cursor:pointer;transition:filter .2s ease;color:#0b0b0a;font-family:inherit}
      .pd-consent-btn:hover{filter:brightness(1.08)}
      .pd-consent-allow{background:#c89b52}
      .pd-consent-deny{background:transparent;border-color:rgba(255,255,255,.18);color:#f4f4f1}
      .pd-consent-btn:focus-visible{outline:2px solid #c89b52;outline-offset:2px}
      @media (max-width:480px){#pd-consent{left:10px;right:10px;bottom:10px}.pd-consent-inner{padding:16px}}
    </style>
    <script is:inline>
      (function () {
        var KEY = 'pd_consent_v1';
        var banner = document.getElementById('pd-consent');
        function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        function setConsent(val) {
          try { localStorage.setItem(KEY, val); } catch (e) {}
          try {
            gtag('consent', 'update', val === 'granted'
              ? { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted', personalization_storage: 'granted', functionality_storage: 'granted', security_storage: 'granted' }
              : { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', personalization_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted' });
          } catch (e) {}
        }
        if (banner && !read()) {
          banner.hidden = false;
          var btns = banner.querySelectorAll('[data-pd-consent]');
          for (var i = 0; i < btns.length; i++) {
            btns[i].addEventListener('click', function () {
              var val = this.getAttribute('data-pd-consent');
              setConsent(val);
              banner.hidden = true;
              if (val === 'granted') { setTimeout(function () { location.reload(); }, 250); }
            });
          }
        }
      })();
    </script>
  </body>
</html>

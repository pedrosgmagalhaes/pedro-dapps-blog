---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SubscribeSection from '../components/SubscribeSection.astro';
import { SITE_DESCRIPTION, YOUTUBE_URL, VIDEOS } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const hasVideos = VIDEOS.length > 0;

const fmt = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<Layout>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero-bg" src="/posters/intro.jpg" alt="" aria-hidden="true" />
    <!-- Vídeo de fundo: mostra o poster (mesma foto) até carregar; então vira animação.
         Se não carregar (rede/device), a foto segue com Ken Burns. -->
    <video
      class="hero-video"
      id="hero-video"
      muted
      loop
      playsinline
      preload="none"
      poster="/posters/intro.jpg"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/videos/pedro3.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="kicker hero-kicker hero-reveal">Conhecimento de tecnologia</p>
      <h1 class="hero-title" id="hero-title">
        <span class="line hero-reveal">IA<span class="gold">.</span></span>
        <span class="line hero-reveal">Blockchain<span class="gold">.</span></span>
        <span class="line hero-reveal">Criação<span class="gold">.</span></span>
      </h1>
      <p class="hero-tagline hero-reveal">
        <span aria-hidden="true">Respirando</span>
        <span class="tagline-word" aria-hidden="true">Tecnologia</span>
        <span class="sr-only">Tecnologia, software, negócios, IA, blockchain, web3, programação e segurança</span>
      </p>
      <div class="hero-actions hero-reveal">
        <a class="btn btn--accent" href={YOUTUBE_URL} target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/>
            <path d="m10 15 5-3-5-3z"/>
          </svg>
          Inscrever-se no YouTube
        </a>
        <a class="hero-scroll-hint" href="#posts">Últimos posts</a>
      </div>
    </div>
  </section>

  <!-- ============ POSTS ============ -->
  <section class="posts" id="posts" aria-label="Lista de posts">
    <div class="section-head" data-reveal>
      <h2 class="section-title">Últimos <span class="gold">posts</span></h2>
      <span class="section-count">{posts.length}</span>
    </div>
    <p class="section-sub" data-reveal>{SITE_DESCRIPTION}</p>

    <ol class="post-list">
      {posts.map((post, i) => (
        <li class="post-item" data-reveal style={`--reveal-delay: ${Math.min(i * 60, 240)}ms`}>
          <a class={`post-link${post.data.cover ? ' post-link--thumb' : ''}`} href={`/posts/${post.id}/`}>
            <span class="post-index">{String(i + 1).padStart(2, '0')}</span>
            {post.data.cover && (
              <span class="post-thumb">
                <img src={post.data.cover} alt="" loading="lazy" draggable="false" />
              </span>
            )}
            <span class="post-body">
              <span class="post-title">{post.data.title}</span>
              <span class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {fmt.format(post.data.pubDate)}
                </time>
                {post.data.tags.length > 0 && (
                  <span class="post-tags">{post.data.tags.map((t) => `#${t}`).join('  ')}</span>
                )}
              </span>
            </span>
            <span class="post-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ VÍDEOS DO CANAL ============ -->
  <section class="videos" aria-label="Vídeos do canal">
    <div class="videos-inner">
      <div class="section-head" data-reveal>
        <h2 class="section-title">Do canal no <span class="gold">YouTube</span></h2>
      </div>
      <div class="videos-grid {hasVideos ? '' : 'videos-grid--solo'}">
        <div class="channel-card" data-reveal>
          <div class="channel-head">
            <span class="channel-avatar">
              <img src="/images/pedro_avatar.png" alt="" width="58" height="58" loading="lazy" />
            </span>
            <span>
              <span class="channel-name">Pedro dApps</span>
              <span class="channel-handle">@pedro_dapps</span>
            </span>
          </div>
          <p class="channel-desc">
            Conteúdo direto e prático sobre Inteligência Artificial, Blockchain, Web3,
            programação, segurança e o universo de tecnologia — no blog e no canal.
          </p>
          <div class="channel-actions">
            <a class="btn btn--accent" href={YOUTUBE_URL} target="_blank" rel="noopener">Inscrever-se</a>
            <a class="btn btn--ghost" href={YOUTUBE_URL} target="_blank" rel="noopener">Ver canal</a>
          </div>
        </div>

        {VIDEOS.map((video) => (
          <a
            class="video-card"
            href={`https://www.youtube.com/watch?v=${video.id}`}
            target="_blank"
            rel="noopener"
            data-reveal
          >
            <span class="video-thumb">
              <img
                src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                alt={`Thumbnail do vídeo: ${video.title}`}
                loading="lazy"
                draggable="false"
              />
              <span class="video-play" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="m8 5 14 7-14 7V5z"/>
                </svg>
              </span>
            </span>
            <span class="video-body">
              <span class="video-badge">{video.badge}</span>
              <span class="video-title">{video.title}</span>
              <span class="video-sub">{video.sub}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ INSCRIÇÃO ============ -->
  <SubscribeSection />
</Layout>

<script>
  // Hero: a foto (poster/Ken Burns) fica visível até o vídeo de fundo carregar;
  // então ele toca em loop e faz crossfade suave por cima. Se o autoplay for
  // bloqueado ou o vídeo não carregar, a foto permanece — nada quebra.
  const heroVideo = document.getElementById('hero-video');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (heroVideo && !reduceMotion) {
    heroVideo.muted = true;
    heroVideo.playsInline = true;
    heroVideo.loop = true;

    const tryPlay = () => {
      const p = heroVideo.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    };

    heroVideo.addEventListener('canplay', tryPlay, { once: true });
    heroVideo.addEventListener('playing', () => {
      heroVideo.classList.add('hero-video--playing');
    });

    // Vídeo é leve (~70KB): começa a baixar no load da página
    heroVideo.preload = 'auto';
    heroVideo.load();

    // Fallback: se nada tocou em 8s (rede lenta/bloqueio), tenta de novo;
    // se ainda falhar, a foto com Ken Burns continua como hoje.
    window.setTimeout(() => {
      if (heroVideo.paused && heroVideo.readyState >= 2) tryPlay();
    }, 8000);
  }
</script>

---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { YOUTUBE_URL } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.cover ?? '/og-thumbnail.png'}
>
  <article class="post">
    <header class="post-header" data-reveal>
      <a class="back-link" href="/">← Todos os posts</a>
      <p class="kicker">
        {post.data.tags.length > 0
          ? post.data.tags.map((t) => `#${t}`).join('  ')
          : 'Pedro dApps'}
      </p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {fmt.format(post.data.pubDate)}
        </time>
        {post.data.updatedDate && (
          <span class="post-updated">
            · atualizado em {fmt.format(post.data.updatedDate)}
          </span>
        )}
      </p>
    </header>

    {post.data.cover && (
      <figure class="post-cover" data-reveal>
        <img src={post.data.cover} alt="" loading="eager" />
      </figure>
    )}

    {post.data.youtubeId && (
      <div class="youtube-wrap" data-reveal>
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${post.data.youtubeId}`}
          title={`Vídeo: ${post.data.title}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <div class="prose" data-reveal>
      <Content />
    </div>

    <footer class="post-footer">
      <div class="post-cta" data-reveal>
        <div class="post-cta-copy">
          <p class="post-cta-title">Gostou? Assine o canal</p>
          <p class="post-cta-desc">
            Tecnologia explicada de forma direta: IA, Blockchain, Web3, programação e
            segurança — toda semana no YouTube e aqui no blog.
          </p>
        </div>
        <a class="btn btn--accent" href={YOUTUBE_URL} target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/>
            <path d="m10 15 5-3-5-3z"/>
          </svg>
          Inscrever-se
        </a>
      </div>
      <a class="back-link" href="/">← Todos os posts</a>
    </footer>
  </article>
</Layout>

---
import { YOUTUBE_URL, MAIN_SITE_URL } from '../consts';

const current = Astro.url.pathname;
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Pedro dApps — Blog">
    Pedro<span class="brand-gold">·</span>dApps
    <span class="brand-tag">Blog</span>
  </a>
  <nav class="nav" aria-label="Navegação principal">
    <a class="nav-link" href="/" aria-current={current === '/' ? 'page' : undefined}>Blog</a>
    <a class="nav-link" href={MAIN_SITE_URL} target="_blank" rel="noopener">Site</a>
    <a class="nav-link" href={YOUTUBE_URL} target="_blank" rel="noopener">YouTube ↗</a>
  </nav>
</header>

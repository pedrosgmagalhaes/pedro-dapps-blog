<!-- Preloader cinematográfico — VU-meter (mesma assinatura do site oficial) -->
<div class="preloader" role="status" aria-live="polite" aria-label="Carregando site">
  <div class="preloader-glass">
    <div class="meter-heading">
      <span>Carregando blog</span>
      <strong id="load-percentage">0%</strong>
    </div>
    <div class="vu-meter" aria-hidden="true">
      <div class="vu-labels">
        <span>0%</span><span>25%</span><span>50%</span><span>75%</span><span class="danger-label">85%</span><span>100%</span>
      </div>
      <div class="vu-track" id="vu-track"></div>
      <div class="vu-needle" id="vu-needle"></div>
    </div>
    <p class="preloader-copy">pedrodapps.com/blog</p>
  </div>
</div>
<div class="wipe-edge" aria-hidden="true"></div>

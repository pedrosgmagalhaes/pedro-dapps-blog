---
import { YOUTUBE_URL, MAIN_SITE_URL } from '../consts';
---
<section class="subscribe-section" aria-labelledby="subscribe-title">
  <img class="subscribe-bg" src="/posters/blockchain.jpg" alt="" aria-hidden="true" loading="lazy" />
  <div class="subscribe-shade" aria-hidden="true"></div>
  <div class="subscribe-inner">
    <p class="kicker" data-reveal>Inscrição</p>
    <h2 class="subscribe-title" id="subscribe-title" data-reveal>
      Fique por <span class="gold">dentro</span>
    </h2>
    <p class="subscribe-desc" data-reveal>
      Conteúdo de tecnologia direto no seu feed: análises, tutoriais, bastidores e
      experimentos. Escolha como prefere receber as novidades.
    </p>

    <div class="subscribe-grid" data-reveal>
      <!-- Notificação no navegador (Web Push nativo) -->
      <div class="notify-card">
        <span class="notify-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
          </svg>
        </span>
        <div class="notify-body">
          <h3 class="notify-title">Notificação no navegador</h3>
          <p class="notify-desc" data-push-status>
            Receba um aviso quando um novo post for publicado.
          </p>
          <button class="btn btn--ghost notify-button" type="button" data-push-button>
            Ativar notificações
          </button>
        </div>
      </div>

      <!-- Newsletter por e-mail -->
      <div class="notify-card">
        <span class="notify-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <path d="m22 6-10 7L2 6"/>
          </svg>
        </span>
        <div class="notify-body">
          <h3 class="notify-title">Newsletter por e-mail</h3>
          <p class="notify-desc">Os posts mais recentes na sua caixa de entrada.</p>
          <form class="newsletter-form" data-newsletter-form novalidate>
            <input
              type="email"
              name="email"
              placeholder="Seu melhor e-mail"
              aria-label="Seu e-mail"
              data-newsletter-email
              required
            />
            <button class="btn btn--accent" type="submit">Assinar</button>
          </form>
          <p class="form-message" data-newsletter-message aria-live="polite"></p>
        </div>
      </div>
    </div>

    <div class="subscribe-actions" data-reveal>
      <a class="btn btn--accent" href={YOUTUBE_URL} target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/>
          <path d="m10 15 5-3-5-3z"/>
        </svg>
        YouTube
      </a>
      <a class="btn btn--ghost" href="/rss.xml">Feed RSS</a>
      <a class="btn btn--ghost" href={MAIN_SITE_URL} target="_blank" rel="noopener">Site oficial</a>
    </div>

    <p class="subscribe-foot" data-reveal>
      Sem spam. Cancele quando quiser — <a href="#" data-newsletter-unsubscribe>cancelar inscrição por e-mail</a>.
    </p>
  </div>
</section>

{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "services": [
    {
      "name": "pedro-dapps-blog",
      "type": "web",
      "port": 3000,
      "cpu": 1,
      "memoryMB": 512,
      "minReplicas": 1,
      "maxReplicas": 1,
      "command": "npm start"
    }
  ]
}
